NEXT_PUBLIC_SUPABASE_URL=your-value-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-value-here
SUPABASE_SERVICE_ROLE_KEY=your-value-here

# Email (Resend) — Required for invitation and confirmation emails
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your-value-here
EMAIL_FROM=your-value-here
# Optional: redirect all emails to this address during dev/testing
# FORCE_TO_EMAIL=your@email.com

# Servicio de descuentos (almuerzo-discounts). En Cloud Run lo pone cloudbuild.yaml. En local, sin esta variable la PWA
# funciona sin descuentos; para probarlos: `gcloud run services proxy almuerzo-discounts --region us-central1 --port 8099`
# y DISCOUNTS_SERVICE_URL=http://localhost:8099 (http:// no envía token).
DISCOUNTS_SERVICE_URL=
