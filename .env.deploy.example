# Copia este archivo a .env.deploy.local (ya ignorado por git via .env.*.local) y completa los valores reales.
# deploy_pwa.sh lo carga automáticamente si existe.
#
# Los secretos de runtime (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, CRON_SECRET) NO van acá:
# se inyectan en Cloud Run directo desde Secret Manager via --set-secrets en cloudbuild.yaml.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_TICKET_URL=
NEXT_PUBLIC_PWA_URL=
